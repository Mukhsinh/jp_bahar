# Server Configuration (aaPanel / Node.js)
NODE_ENV=production
PORT=3002
HOSTNAME=0.0.0.0

# Optional: comma-separated domain list for Next.js Server Actions behind reverse proxy
# ALLOWED_ORIGINS=jaspel.domainanda.com,www.jaspel.domainanda.com

# Supabase Configuration (Wajib diisi sebelum menjalankan `npm run build`)
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
